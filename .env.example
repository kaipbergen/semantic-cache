# Groq API key used by the LLM worker to answer cache misses
GROQ_API_KEY=your_groq_api_key_here

# Redis connection string (job status, prompt->response payloads, TTLs)
REDIS_URL=redis://redis:6379

# Kafka bootstrap servers for the request/response pipeline
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Directory where the FAISS index, prompt store, and index metadata are persisted
INDEX_DIR=/app/faiss_index

# Bi-encoder model used for fast retrieval embeddings
BI_ENCODER_MODEL=multi-qa-mpnet-base-dot-v1
# Cross-encoder model used to rerank retrieval candidates
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Minimum bi-encoder similarity for a candidate to be considered
SIMILARITY_THRESHOLD=0.85
# Minimum cross-encoder score for a candidate to count as a cache hit
CROSS_ENCODER_THRESHOLD=0.5

# TTL (seconds) applied to short-lived cache entries (default classification)
CACHE_TTL_SHORT=3600
# TTL (seconds) applied to long-lived cache entries (explain/describe/etc prompts)
CACHE_TTL_LONG=86400

# Max number of entries kept in the cache before oldest entries are evicted (0 = unlimited)
MAX_CACHE_SIZE=0
# Payloads larger than this (bytes) are gzip-compressed before being stored in Redis
COMPRESSION_THRESHOLD_BYTES=1024

# How long the API waits for an LLM response over Kafka before returning 202 (seconds)
RESPONSE_TIMEOUT_SECONDS=8
# Max prompt length accepted by /query and /cache/seed (characters)
MAX_PROMPT_LENGTH=4096
# Max number of prompts accepted per /query/batch request
MAX_BATCH_SIZE=50
# Max value a client may request via the ?timeout= query param override (seconds)
MAX_TIMEOUT_OVERRIDE_SECONDS=60

# Token bucket capacity and refill rate for per-client-IP rate limiting on /query
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SECOND=5

# Interval (seconds) between automatic prunes of expired cache entries; 0 disables the background task
COMPACTION_INTERVAL_SECONDS=0

# Optional API key required via the X-API-Key header when set (auth disabled if unset)
API_KEY=
# Comma-separated list of origins allowed by CORS ("*" allows all)
CORS_ALLOWED_ORIGINS=*

# Version string reported by /health (informational only)
APP_VERSION=0.1.0

# Max attempts (including the first) the worker makes to call the LLM before
# routing the request to the llm-requests-dlq dead-letter topic
LLM_CALL_MAX_ATTEMPTS=3
# Base delay (seconds) for exponential backoff between LLM call retries
LLM_CALL_RETRY_BASE_DELAY=0.5

# Per-call timeout (seconds) for a single Groq request before it's treated as a failure
LLM_CALL_TIMEOUT_SECONDS=10
# Consecutive Groq call failures before the circuit breaker opens and rejects calls fast
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# How long (seconds) the circuit breaker stays open before allowing a half-open trial call
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30

# LLM calls slower than this (ms) are logged as a slow-query warning
SLOW_QUERY_THRESHOLD_MS=5000
